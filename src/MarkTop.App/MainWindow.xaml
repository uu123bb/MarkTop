<Window x:Class="MarkTop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:MarkTop.App"
        Title="MarkTop" Height="820" Width="1280" MinHeight="480" MinWidth="760"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <HierarchicalDataTemplate x:Key="FileTemplate" DataType="{x:Type local:FileNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Glyph}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- title / toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MarkTop" FontWeight="SemiBold" FontSize="13" Margin="2,0,12,0"
                               VerticalAlignment="Center" />
                    <Button Content="打开" Style="{StaticResource ToolButton}" Click="OnOpenFileClick"
                            ToolTip="打开文件 (Ctrl+O)" />
                    <Button Content="文件夹" Style="{StaticResource ToolButton}" Click="OnOpenFolderClick"
                            ToolTip="打开文件夹作为工作区" />
                    <Button Content="保存" Style="{StaticResource ToolButton}" Click="OnSaveClick"
                            ToolTip="保存 (Ctrl+S)" />
                    <Button Content="导出" Style="{StaticResource ToolButton}" Click="OnExportClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Markdown (.md)" Click="OnExportMarkdownClick" />
                                <MenuItem Header="HTML（自包含）" Click="OnExportHtmlClick" />
                                <MenuItem Header="PDF" Click="OnExportPdfClick" />
                                <Separator />
                                <MenuItem Header="从 HTML 导入…" Click="OnImportHtmlClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="GitHub README" Style="{StaticResource ToolButton}" Click="OnGitReadmeClick"
                            ToolTip="拉取并编辑 GitHub 个人主页 README" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource PanelAltBrush}" Height="30">
                    <Border CornerRadius="6" Background="{DynamicResource PanelAltBrush}" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeSplit" Content="双栏" GroupName="Mode"
                                         Style="{StaticResource SegmentButton}" IsChecked="True"
                                         Checked="OnModeChecked" Tag="split" />
                            <RadioButton x:Name="ModeSource" Content="源码" GroupName="Mode"
                                         Style="{StaticResource SegmentButton}" Checked="OnModeChecked" Tag="source" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Content="☾" Style="{StaticResource ToolButton}"
                            FontSize="14" Click="OnToggleThemeClick" ToolTip="切换深浅主题" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" MinWidth="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,10,8,6">
                        <TextBlock Text="工作区" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <Button Content="打开文件夹" HorizontalAlignment="Right" FontSize="11"
                                Style="{StaticResource ToolButton}" Padding="6,2" Click="OnOpenFolderClick" />
                    </Grid>
                    <TextBlock x:Name="WorkspaceLabel" DockPanel.Dock="Top" Margin="12,0,12,8"
                               FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Text="尚未打开文件夹" />
                    <TreeView x:Name="FileTree" Margin="4,0,4,8" Padding="4"
                              ItemTemplate="{DynamicResource FileTemplate}"
                              TreeViewItem.Expanded="OnFileTreeExpanded"
                              MouseDoubleClick="OnFileTreeDoubleClick" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <ItemsControl x:Name="TabBar" ItemsSource="{Binding Tabs}" Margin="6,4,6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabRoot" Margin="0,0,2,0" CornerRadius="6,6,0,0" Padding="10,5,4,5"
                                        Background="Transparent" BorderThickness="0,0,0,0"
                                        MouseLeftButtonDown="OnTabClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text=" •" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Visibility="{Binding Dirty, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="×" Style="{StaticResource ToolButton}" FontSize="12"
                                                Padding="5,0" Margin="6,0,0,0" Click="OnTabCloseClick"
                                                ToolTip="关闭标签" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabRoot" Property="Background"
                                                Value="{DynamicResource AppBackgroundBrush}" />
                                        <Setter TargetName="TabRoot" Property="BorderThickness" Value="0,0,0,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter TargetName="TabRoot" Property="Opacity" Value="0.72" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <wv2:WebView2 x:Name="EditorWebView" Grid.Row="1" DefaultBackgroundColor="#1E1E1E" />
                <Border x:Name="LoadingOverlay" Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="正在加载编辑器…" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                   HorizontalAlignment="Center" />
                        <ProgressBar IsIndeterminate="True" Width="180" Height="3" Margin="0,14,0,0"
                                     Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusPath" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="就绪" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusCursor" FontSize="11.5" Margin="0,0,14,0"
                               Foreground="{DynamicResource MutedBrush}" Text="Ln 1, Col 1" />
                    <TextBlock x:Name="StatusCounts" FontSize="11.5" Margin="0,0,14,0"
                               Foreground="{DynamicResource MutedBrush}" Text="0 字" />
                    <TextBlock x:Name="StatusEncoding" FontSize="11.5" Margin="0,0,14,0"
                               Foreground="{DynamicResource MutedBrush}" Text="UTF-8" />
                    <TextBlock x:Name="StatusEol" FontSize="11.5" Margin="0,0,14,0"
                               Foreground="{DynamicResource MutedBrush}" Text="LF" />
                    <TextBlock x:Name="StatusLint" FontSize="11.5" Margin="0,0,14,0"
                               Foreground="{DynamicResource MutedBrush}" Text="" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
